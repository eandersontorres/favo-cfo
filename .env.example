# ── Supabase (same project as Clariva Kitchen) ──────────────────
VITE_SUPABASE_URL=https://huurnewugpwerkeusolt.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Tenant ───────────────────────────────────────────────────────
VITE_TENANT_ID=your_tenant_id_here

# ── App ──────────────────────────────────────────────────────────
VITE_APP_NAME=Clariva Ledger
VITE_APP_VERSION=1.0.0

# ── Server-side only (NO VITE_ prefix — never exposed to the browser) ──
# Service role key: lets /api/* functions read the RLS-locked Plaid token table.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Plaid (bank connection) ──────────────────────────────────────
# Using Limited Production: connect a REAL bank (Bank of America, etc.) for free
# (~200 API calls per product, no card). Enable Production in the Plaid dashboard
# (self-serve) and use the PRODUCTION secret here — each env has its own secret.
# PLAID_SECRET differs per env; the production secret is NOT the sandbox one.
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_production_secret_here
PLAID_ENV=production
# Required for OAuth banks (Bank of America forces OAuth). Must also be
# registered in the Plaid dashboard under Team Settings -> Allowed redirect URIs.
# Still clariva.cloud on purpose — update the Plaid allowed list before favo.team.
PLAID_REDIRECT_URI=https://cfo.clariva.cloud/
# To test against fake banks instead, set PLAID_ENV=sandbox (creds user_good / pass_good).

# ── Cron / internal API auth ─────────────────────────────────────
# REQUIRED. The sync endpoints (sync-square-*, plaid-sync) run as service role,
# so they verify their caller: either a logged-in user's Supabase token (the
# browser forwards it) or this shared secret. api/cron-sync-square.js has no
# user session, so it presents this on every internal call — without it the
# nightly sync returns 500 and no revenue lands. Vercel also sends it as
# `Authorization: Bearer <CRON_SECRET>` on the scheduled invocation.
# Generate: openssl rand -hex 32
CRON_SECRET=your_long_random_secret_here
# Custom domain for internal API calls. Vercel Authentication 401s every
# *.vercel.app URL in this project, so cron MUST go through a custom domain.
# Defaults to https://cfo.clariva.cloud when unset.
CFO_PUBLIC_URL=https://cfo.clariva.cloud
